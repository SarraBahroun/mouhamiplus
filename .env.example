# Copie ce fichier en .env.local et remplis les valeurs depuis
# Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé privée — jamais exposée au navigateur, utilisée uniquement
# dans des scripts serveur/admin (seed, migrations, tâches cron).
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
